# LLM Configuration
ECOM_LLM_API_KEY=your_api_key_here
ECOM_LLM_BASE_URL=https://api.minimax.chat/v1
ECOM_LLM_MODEL=MiniMax-M1

# Redis
ECOM_REDIS_URL=redis://localhost:6379/0

# Milvus
ECOM_MILVUS_HOST=localhost
ECOM_MILVUS_PORT=19530

# Database（MySQL 8.0 + asyncmy）。留空或未配置时应用仍可启动，
# 只有依赖数据库的只读接口返回 503；迁移需显式执行 alembic upgrade head。
ECOM_DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/ecommerce

# 隔离的 MySQL 测试库，仅供 tests/ 下的迁移、约束与事务测试读取，
# 不进入应用配置。必须与 ECOM_DATABASE_URL 指向不同的库。
# ECOM_TEST_DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/ecommerce_test

# A/B Testing
ECOM_AB_TEST_ENABLED=true
