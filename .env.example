# LLM Configuration
ECOM_LLM_API_KEY=your_api_key_here
ECOM_LLM_BASE_URL=https://api.minimax.chat/v1
ECOM_LLM_MODEL=MiniMax-M1

# Redis
ECOM_REDIS_URL=redis://localhost:6379/0

# Milvus
ECOM_MILVUS_HOST=localhost
ECOM_MILVUS_PORT=19530

# Database（MySQL 8.0 + asyncmy）。留空或未配置时应用仍可启动，
# 只有依赖数据库的只读接口返回 503；迁移需显式执行 alembic upgrade head。
ECOM_DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/ecommerce

# 隔离的 MySQL 测试库，仅供 tests/ 下的迁移、约束与事务测试读取，
# 不进入应用配置。必须与 ECOM_DATABASE_URL 指向不同的库。
# ECOM_TEST_DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/ecommerce_test

# A/B Testing
ECOM_AB_TEST_ENABLED=true

# Identity：演示账号 + 短期 RS256 访问令牌。
# 演示邮箱只是登录名，不验证邮箱所有权；密码哈希、令牌签发与撤销是真实路径。
# development / test / demo 允许演示注册；production 一律拒绝 source=demo 的注册与登录。
ECOM_IDENTITY_ENVIRONMENT=production
ECOM_IDENTITY_DEMO_MODE=false
ECOM_IDENTITY_ISSUER=https://identity.example.com
ECOM_IDENTITY_AUDIENCE=ecom-api
# 只填路径，不要把密钥内容写进仓库或 .env。
# 私钥为 PEM；公钥集合是 {"kid": "-----BEGIN PUBLIC KEY-----..."} 的 JSON。
ECOM_IDENTITY_PRIVATE_KEY_PATH=/run/secrets/identity-private.pem
ECOM_IDENTITY_PUBLIC_KEYS_PATH=/run/secrets/identity-public-keys.json
# 当前签发用的 kid，必须存在于公钥集合中；轮换时先分发新公钥再切换此值。
ECOM_IDENTITY_ACTIVE_KID=key-2026-09
# CSRF 签名密钥，至少 32 字符，与令牌签名密钥分离。
ECOM_IDENTITY_CSRF_SECRET=replace-with-at-least-32-random-characters
ECOM_IDENTITY_ACCESS_TOKEN_TTL_SECONDS=900
# 登录会话绝对到期（秒），不因刷新而延长。
ECOM_IDENTITY_SESSION_TTL_SECONDS=2592000
ECOM_IDENTITY_CLOCK_SKEW_SECONDS=30
# 可信前端来源，逗号分隔；留空表示不允许任何跨站来源，绝不使用 *。
ECOM_IDENTITY_ALLOWED_ORIGINS=https://app.example.com
# 可信反向代理 CIDR，逗号分隔；只有直接来源命中时才解析 X-Forwarded-For。
ECOM_IDENTITY_TRUSTED_PROXY_NETWORKS=10.0.0.0/8
ECOM_IDENTITY_LOGIN_EMAIL_LIMIT=5
ECOM_IDENTITY_LOGIN_IP_LIMIT=30
ECOM_IDENTITY_REGISTER_IP_LIMIT=3
ECOM_IDENTITY_REFRESH_SESSION_LIMIT=30
ECOM_IDENTITY_LOGIN_WINDOW_SECONDS=900
ECOM_IDENTITY_REGISTER_WINDOW_SECONDS=3600
ECOM_IDENTITY_REFRESH_WINDOW_SECONDS=60

# 隔离的 Redis 测试库，仅供 tests/ 下的限流测试读取，不进入应用配置。
# ECOM_TEST_REDIS_URL=redis://localhost:16379/15
